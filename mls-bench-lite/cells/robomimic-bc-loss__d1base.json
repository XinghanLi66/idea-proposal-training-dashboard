    "robomimic_custom_bc_loss.py (step 3)": "\"\"\"\nCustom BC Loss Function for GMM-based Behavioral Cloning.\n\nThis module defines the loss function used by BC-GMM training in robomimic.\nThe loss receives the GMM distribution produced by the policy network and\nthe expert demonstration actions, and returns a scalar loss.\n\nThe custom loss is imported and used by the patched BC_GMM._compute_losses\nmethod during training.\n\"\"\"\n\nimport torch\nimport torch.nn as nn\nimport torch.nn.functional as F\nimport torch.distributions as D\n\n\n# ── Custom BC Loss Function ────────────────────────────────────────────────\n# EDITABLE REGION START\nclass CustomBCLoss(nn.Module):\n    \"\"\"NLL + empirical-variance alignment for GMM-based behavioral cloning.\n\n    In addition to the standard NLL, adds a regularizer that matches the\n    GMM's per-dimension predictive variance to the empirical per-dimension\n    variance of expert actions in the mini-batch. This encourages precise\n    (low-variance) predictions in dimensions where the demonstrations are\n    consistent (e.g., gripper), while allowing flexibility in dimensions\n    with naturally higher variability (e.g., end-effector deltas).\n\n    Args:\n        dist: MixtureSameFamily GMM distribution (5 modes, 7-dim actions)\n        target_actions: [B, 7] expert actions\n\n    Returns:\n        scalar loss tensor\n    \"\"\"\n\n    def __init__(self, action_dim=7, beta=0.003, eps=1e-6):\n        super().__init__()\n        self.action_dim = action_dim\n        self.beta = beta\n        self.eps = eps\n\n    def forward(self, dist, target_actions):\n        nll = -dist.log_prob(target_actions).mean()\n\n        # Empirical per-dimension variance of expert actions in the batch\n        with torch.no_grad():\n            emp_var = target_actions.var(dim=0, unbiased=False)\n            emp_var = emp_var.clamp_min(self.eps)\n            log_emp = torch.log(emp_var).clamp(-10.0, 10.0)  # [7]\n\n        # GMM predictive variance per dimension (mixture variance), [B, 7]\n        pred_var = dist.variance.clamp_min(self.eps)\n        log_pred = torch.log(pred_var).clamp(-10.0, 10.0)\n\n        # Align log-variances (log space handles wide dynamic ranges stably)\n        var_reg = (log_pred - log_emp.unsqueeze(0)).pow(2).mean()\n\n        return nll + self.beta * var_reg\n# EDITABLE REGION END\n# EDITABLE REGION END\n"
   },
